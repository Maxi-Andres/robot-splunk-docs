            <path class="base" d="M164,232 C205,232 212,333 250,333"/>
            <path class="flow $wired_cls$" d="M164,232 C205,232 212,333 250,333" style="animation-duration:3.2s"/>

            <!-- ENLACES: las dos ramas convergen en el switch -->
