<form version="1.1" theme="dark">
  <label>Robot Go2 — Telemetría</label>
  <description>Telemetría en vivo del Unitree Go2 vía HEC. Video embebido desde mediamtx.</description>
  <!-- El nombre del agente de ThousandEyes del robot, en UN solo lugar. Este dashboard es
       del Go2: todo panel de TE filtra por este token. Si el agente se re-enrola con otro
       nombre, se cambia acá y nada mas. -->
  <init>
    <set token="te_agent">go2-jetson-01</set>
    <!-- El agente del Jetson corre mas de un test. Los singles y el timechart miden EL
         ENLACE DEL ROBOT; sin este token promediaban todos los tests juntos y un test
         caido (cualquiera del mismo agente) ensuciaba la perdida del enlace. -->
    <set token="te_test">Go2 - A1 - Jetson a IR1101 (interno)</set>
    <!-- Prefijo del tag de TE. Los paneles de "todos los tests" filtran por nombre. -->
    <set token="te_tag">Go2</set>
  </init>
  <!-- ============ FILA 1: estado de un vistazo ============ -->
  <!-- ============ FILA 2: video + eventos ============ -->
  <!-- ============ FILA 3: series temporales ============ -->
  <!-- ============ FILA 4: motores y pose ============ -->
  <!-- ============ FILA 5: enlace del robot (ThousandEyes) ============ -->
  <!-- Datos de ThousandEyes. Metricas: network.loss (%), network.latency (SEGUNDOS),
       network.jitter (ms), OTel Data Model v2. OJO con latency: v2 la manda en segundos,
       v1 la mandaba en ms. Por eso el *1000.
       TODO filtra por $te_agent$: este es el dashboard del Go2 y solo se ve lo del Go2.
       Hoy el unico test que lo involucra es "Agent to Agent Test" (go2-jetson-01 ->
       TE-ENTERPRISE-SILK). Si se agregan mas tests desde el robot, entran solos.
       El filtro va por `by` + `rename` + `where` y no dentro del WHERE de mstats: los
       nombres de dimension llevan puntos y el quoting adentro de mstats es fragil. Con
       este volumen de datos la diferencia de costo es nula y esto no se rompe.
       Ver ../LICENCIA-Y-THOUSANDEYES.md §5 y §6. -->
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Rango</label>
      <default>
        <earliest>-60m</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Batería</title>
      <single>
        <search>
          <query>index=go2-robot-data sourcetype=robot:vitals
| head 1
| eval soc='battery.soc'
| fields soc</query>
          <refresh>10s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
        <option name="unit">%</option>
        <option name="rangeColors">["0xdc4e41","0xf8be34","0x53a051"]</option>
        <option name="rangeValues">[35,60]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Temp. máx. de motor</title>
      <single>
        <search>
          <query>index=go2-robot-data sourcetype=robot:vitals
| head 1
| eval t='temp.motor_max'
| fields t</query>
          <refresh>10s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="unit">°C</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[60,80]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>DDS vivo (Hz de /lf/lowstate)</title>
      <single>
        <search>
          <query>index=go2-robot-data sourcetype=robot:health
| head 1
| eval hz='topic_hz.lowstate'
| fields hz</query>
          <refresh>10s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="unit">Hz</option>
        <option name="rangeColors">["0xdc4e41","0x53a051"]</option>
        <option name="rangeValues">[0.1]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Enviado hoy (licencia)</title>
      <single>
        <search>
          <query>index=go2-robot-data sourcetype=robot:shipper
| head 1
| eval mb=round('sent_bytes_today'/1024/1024,1)
| fields mb</query>
          <refresh>10s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="unit">MB</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Unidad 02 — Go2 + Starlink</title>
      <html>
        <!-- Servida desde el directorio estático de Splunk, NO desde una URL externa:
             /opt/splunk/etc/apps/search/appserver/static/robot-go2.jpg
             Al ser mismo origen no necesita "Dashboards Trusted Domains" (a diferencia del
             MJPEG de Frigate del panel de al lado) y no depende de que la PC .20.99 esté
             prendida. El original vive en dashboards/assets/robot-go2.jpg de este repo.
             Para reemplazarla: sobrescribir el archivo con el MISMO nombre y hacer un bump
             de la caché de estáticos -> http://192.168.20.200:8000/en-US/_bump -->
        <img src="/static/app/search/robot-go2.jpg" style="width:100%;max-height:420px;object-fit:contain;background:#000" alt="Unitree Go2, unidad 02, con antena Starlink y caja de electrónica"/>
        <p style="font-size:11px;opacity:.55;margin:6px 0 0">
          Foto de referencia. El video en vivo es el panel de la derecha.
        </p>
      </html>
    </panel>
    <panel>
      <title>Cámara frontal (MJPEG en vivo)</title>
      <html>
        <!-- An <img> pointed at Frigate's MJPEG endpoint, NOT an <iframe>.
             Splunk 9's Simple XML sanitiser strips <iframe> outright — the element never
             reaches the browser and no setting re-enables it. <img> survives, and
             "Dashboards Trusted Domains" is exactly the feature meant to authorise an
             external image source. Frigate serves multipart/x-mixed-replace at
             /api/<camera>, which is a live MJPEG stream a plain <img> can render.
             fps and h are capped to keep the bandwidth modest; the browser fetches this
             straight from Frigate, so it costs ZERO Splunk licence.
             REQUIRED ONCE: add http://192.168.20.99:5000 under
             Settings -> Server settings -> Dashboards Trusted Domains. -->
        <img src="http://192.168.20.99:5000/api/robot?fps=5&amp;h=480" style="width:100%;max-height:420px;object-fit:contain;background:#000" alt="Cámara del robot"/>
        <p style="margin:8px 0 0">
          <a href="http://192.168.20.99:8889/robot" target="_blank">WebRTC (mínima latencia)</a>
           · 
          <a href="http://192.168.20.99:5000" target="_blank">Frigate (timeline y grabaciones)</a>
        </p>
        <!-- <p style="font-size:11px;opacity:.55;margin:6px 0 0">
          Si no se ve: falta autorizar <code>http://192.168.20.99:5000</code> en
          Settings → Server settings → Dashboards Trusted Domains.
        </p> -->
      </html>
    </panel>
    <panel>
      <title>Eventos discretos (cambios de modo, errores, sobretemperatura)</title>
      <table>
        <search>
          <query>index=go2-robot-data sourcetype=robot:event
| eval cambio=prev." -&gt; ".curr
| table _time kind cambio robot
| sort - _time</query>
          <refresh>20s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="count">15</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Batería: carga y voltaje</title>
      <chart>
        <search>
          <query>index=go2-robot-data sourcetype=robot:vitals
| eval soc='battery.soc', volt='power.volt'
| timechart span=1m avg(soc) as "SOC (%)", avg(volt) as "Voltaje (V)"</query>
          <refresh>30s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">SOC / Volt</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Temperaturas</title>
      <chart>
        <search>
          <query>index=go2-robot-data sourcetype=robot:vitals
| eval mt='temp.motor_max', n1='temp.ntc1', n2='temp.ntc2', it='imu.temp'
| timechart span=1m max(mt) as "Motor máx", avg(n1) as "NTC1", avg(n2) as "NTC2", avg(it) as "IMU"</query>
          <refresh>30s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">°C</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Motores — último estado por junta</title>
      <table>
        <search>
          <query>index=go2-robot-data sourcetype=robot:motors
| head 1
| fields "*.temp" "*.tau" "*.q" "*.lost"
| transpose 0 column_name=campo
| rename "row 1" as valor
| rex field=campo "^(?&lt;junta&gt;[A-Z]{2}_[a-z]+)\.(?&lt;metrica&gt;\w+)$"
| where isnotnull(junta)
| chart values(valor) over junta by metrica</query>
          <refresh>20s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="count">12</option>
        <option name="drilldown">none</option>
        <format type="color" field="temp">
          <colorPalette type="list">[#53a051,#f8be34,#dc4e41]</colorPalette>
          <scale type="threshold">60,80</scale>
        </format>
      </table>
    </panel>
    <panel>
      <title>Pose y modo</title>
      <table>
        <search>
          <query>index=go2-robot-data sourcetype=robot:pose
| head 20
| table _time mode gait_type error_code body_height yaw_speed
| sort - _time</query>
          <refresh>20s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Pérdida del enlace — $te_agent$</title>
      <single>
        <search>
          <query>| mstats avg(network.loss) as v WHERE index=thousandeyes by "thousandeyes.source.agent.name", "thousandeyes.test.name"
| rename "thousandeyes.source.agent.name" as agente, "thousandeyes.test.name" as test
| where agente="$te_agent$" AND test="$te_test$"
| stats avg(v) as v
| eval v=round(v,2)</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="unit">%</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[1,5]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Latencia — $te_agent$</title>
      <single>
        <search>
          <query>| mstats avg(network.latency) as v WHERE index=thousandeyes by "thousandeyes.source.agent.name", "thousandeyes.test.name"
| rename "thousandeyes.source.agent.name" as agente, "thousandeyes.test.name" as test
| where agente="$te_agent$" AND test="$te_test$"
| stats avg(v) as v
| eval v=round(v*1000,1)</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="unit">ms</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[80,200]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Jitter — $te_agent$</title>
      <single>
        <search>
          <query>| mstats avg(network.jitter) as v WHERE index=thousandeyes by "thousandeyes.source.agent.name", "thousandeyes.test.name"
| rename "thousandeyes.source.agent.name" as agente, "thousandeyes.test.name" as test
| where agente="$te_agent$" AND test="$te_test$"
| stats avg(v) as v
| eval v=round(v,1)</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="unit">ms</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[10,30]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Agente ThousandEyes del robot</title>
      <!-- El unico panel que dice algo util CON el robot apagado. Sin esto, un agente
           caido y un test sin programar se ven exactamente igual: un hueco. -->
      <single>
        <search>
          <query>index=thousandeyes_alerts sourcetype=thousandeyes:agent agent_name="$te_agent$"
| stats latest(agent_state) as estado, latest(last_seen) as visto
| eval Estado=upper(coalesce(estado,"sin datos"))
| fields Estado</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <!-- Texto, no 1/0. Contra: el coloreo del single value de Simple XML es SOLO
             numerico (rangeValues compara numeros), asi que en texto se pierde el
             rojo/verde. El semaforo vive en la tabla de al lado, que si sabe mapear
             colores por string con <colorPalette type="map">. -->
        <option name="drilldown">none</option>
        <option name="underLabel">estado del agente en ThousandEyes</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Enlace del robot en el tiempo — $te_agent$</title>
      <chart>
        <search>
          <query>| mstats avg(network.loss) as loss, avg(network.latency) as lat_s, avg(network.jitter) as jitter
    WHERE index=thousandeyes span=5m by "thousandeyes.source.agent.name", "thousandeyes.test.name"
| rename "thousandeyes.source.agent.name" as agente, "thousandeyes.test.name" as test
| where agente="$te_agent$" AND test="$te_test$"
| eval "Pérdida (%)"=round(loss,2), "Latencia (ms)"=round(lat_s*1000,1), "Jitter (ms)"=round(jitter,2)
| fields _time "Pérdida (%)" "Latencia (ms)" "Jitter (ms)"</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">ms / %</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Estado del agente — inventario ThousandEyes</title>
      <table>
        <search>
          <query>index=thousandeyes_alerts sourcetype=thousandeyes:agent agent_name="$te_agent$"
| stats latest(agent_state) as Estado, latest(last_seen) as "Último contacto",
        latest(public_ip) as "IP pública", latest(network) as "Red / ISP",
        latest(location) as Ubicación, latest(ip_addresses) as "IP interna",
        latest(agent_type) as Tipo
| transpose column_name=Campo
| rename "row 1" as Valor</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">none</option>
        <!-- Mapa de color por valor: esto SI funciona sobre strings, a diferencia del
             rangeValues del single value. Es el semaforo real del panel de arriba. -->
        <format type="color" field="Valor">
          <colorPalette type="map">{"online":#53a051,"offline":#dc4e41,"sin datos":#f8be34}</colorPalette>
        </format>
      </table>
    </panel>
  </row>
  <!-- ===== Tests con tag "Go2" de ThousandEyes =====
       OJO: el stream OTel NO trae los tags de TE. Las unicas dimensiones son agente, test
       (id y nombre) y tipo. Por eso el "tag Go2" se resuelve por convencion de NOMBRE:
       todo test que empiece con "$te_tag$ - ". Si alguien etiqueta un test en TE sin
       respetar ese prefijo, no aparece en estos paneles. El arreglo de fondo es que el
       te-poller mande el tag como dimension; mientras tanto, el nombre manda.
       Los tests agent-to-server sin datos de path solo reportan network.loss: latencia y
       jitter quedan vacios a proposito, no es un bug del panel. -->
  <row>
    <panel>
      <title>Tests $te_tag$ — resumen</title>
      <table>
        <search>
          <query>| mstats avg(network.loss) as loss, avg(network.latency) as lat, avg(network.jitter) as jit, count(network.loss) as n
    WHERE index=thousandeyes span=5m by "thousandeyes.test.name", "thousandeyes.source.agent.name", "thousandeyes.test.type"
| rename "thousandeyes.test.name" as Test, "thousandeyes.source.agent.name" as Agente, "thousandeyes.test.type" as Tipo
| where like(Test, "$te_tag$ - %")
| stats sum(n) as Muestras, avg(loss) as loss, avg(lat) as lat, avg(jit) as jit, max(_time) as ultima by Test, Agente, Tipo
| eval "Pérdida (%)"=round(loss,2), "Latencia (ms)"=round(lat*1000,1), "Jitter (ms)"=round(jit,2), "Última muestra"=strftime(ultima,"%F %H:%M")
| table Test Agente Tipo Muestras "Pérdida (%)" "Latencia (ms)" "Jitter (ms)" "Última muestra"
| sort Test</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">20</option>
        <format type="color" field="Pérdida (%)">
          <colorPalette type="list">[#53A051,#F8BE34,#DC4E41]</colorPalette>
          <scale type="threshold">1,5</scale>
        </format>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Pérdida por test — $te_tag$</title>
      <chart>
        <search>
          <query>| mstats avg(network.loss) as loss
    WHERE index=thousandeyes span=5m by "thousandeyes.test.name"
| rename "thousandeyes.test.name" as test
| where like(test, "$te_tag$ - %")
| timechart span=5m avg(loss) as "Pérdida (%)" by test</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">%</option>
        <option name="charting.axisY.maximumNumber">100</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.chart.nullValueMode">gaps</option>
      </chart>
    </panel>
    <panel>
      <title>Latencia por test — $te_tag$</title>
      <chart>
        <search>
          <query>| mstats avg(network.latency) as lat
    WHERE index=thousandeyes span=5m by "thousandeyes.test.name"
| rename "thousandeyes.test.name" as test
| where like(test, "$te_tag$ - %")
| eval lat_ms=lat*1000
| timechart span=5m avg(lat_ms) as "Latencia (ms)" by test</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">ms</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.chart.nullValueMode">gaps</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Alertas de ThousandEyes</title>
      <!-- Vacio hasta que exista el webhook de alertas de TE. Las columnas quedan sin fijar
           a proposito: el payload no esta verificado contra un evento real todavia. -->
      <table>
        <search>
          <query>index=thousandeyes_alerts sourcetype=thousandeyes:alert
| sort - _time
| table _time *</query>
          <refresh>60s</refresh>
          <refreshType>delay</refreshType>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="count">15</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <!-- ==== INICIO SECCION IR1101 (agregado 2026-09-15) ==== -->
  <row>
    <panel>
      <html>
        <div style="border-left:4px solid #53a051;padding:8px 14px;margin:6px 0;background:#1a1c20;">
          <h2 style="margin:0;color:#dcdcdc;font-size:16px;">Cisco IR1101 — IR1101-GO2-01</h2>
          <div style="color:#9aa0a6;font-size:12px;">Agente ThousandEyes LAB-IR-1101 · index=te_agents · muestreo ~5 min</div>
        </div>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <title>CPU 1 min</title>
      <single>
        <search><query>index=te_agents sourcetype="silk:router:cpu" | head 1 | fields cpu_1min_pct</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="drilldown">none</option>
        <option name="unit">%</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[60,85]</option>
        <option name="useColors">1</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <title>Memoria Processor</title>
      <single>
        <search><query>index=te_agents sourcetype="silk:router:mem" pool="Processor" | head 1 | fields used_pct</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="drilldown">none</option>
        <option name="unit">%</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[70,90]</option>
        <option name="useColors">1</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <title>Temperatura TS1</title>
      <single>
        <search><query>index=te_agents sourcetype="silk:router:env" sensor="Temp: TS1" | head 1 | fields temp_c</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="drilldown">none</option>
        <option name="unit">°C</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[55,70]</option>
        <option name="useColors">1</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <title>Señal LTE (RSSI)</title>
      <single>
        <search><query>index=te_agents sourcetype="silk:router:cellular" | head 1 | fields rssi_dbm</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="drilldown">none</option>
        <option name="unit">dBm</option>
        <option name="rangeColors">["0xdc4e41","0xf8be34","0x53a051"]</option>
        <option name="rangeValues">[-100,-85]</option>
        <option name="useColors">1</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <title>WAN activas (de 3)</title>
      <single>
        <search><query>index=te_agents sourcetype="silk:router:iface" iface IN ("Gi0/0/0","Vl40","Ce0/1/0") | stats latest(oper_status) as op by iface | search op=up | stats count</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="drilldown">none</option>
        <option name="rangeColors">["0xdc4e41","0xf8be34","0x53a051"]</option>
        <option name="rangeValues">[1,2]</option>
        <option name="useColors">1</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Enlaces WAN — IR1101</title>
      <table>
        <search><query>index=te_agents sourcetype="silk:router:iface" iface IN ("Gi0/0/0","Vl40","Ce0/1/0") | stats latest(alias) as Alias latest(admin_status) as Admin latest(oper_status) as Oper latest(speed_mbps) as nom latest(in_bps) as ib latest(out_bps) as ob latest(in_errors_ps) as ie latest(out_errors_ps) as oe latest(in_discards_ps) as di latest(out_discards_ps) as do_ by iface | eval "Nominal (Mbps)"=nom, "In (Mbps)"=round(ib/1000000,2), "Out (Mbps)"=round(ob/1000000,2), "Err/s"=round(ie+oe,2), "Descartes/s"=round(di+do_,2), Rol=case(iface="Gi0/0/0","WAN primaria - Starlink Mini", iface="Vl40","WAN IPLAN", iface="Ce0/1/0","WAN backup - LTE Movistar", true(),"-"), orden=case(iface="Gi0/0/0",1, iface="Vl40",2, iface="Ce0/1/0",3, true(),9) | sort orden | rename iface as Interfaz | table Interfaz Rol Alias Admin Oper "Nominal (Mbps)" "In (Mbps)" "Out (Mbps)" "Err/s" "Descartes/s"</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
        <format type="color" field="Oper"><colorPalette type="map">{"up":#53A051,"down":#DC4E41}</colorPalette></format>
        <format type="color" field="Admin"><colorPalette type="map">{"up":#53A051,"down":#707070}</colorPalette></format>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>LAN del robot y management — IR1101</title>
      <table>
        <search><query>index=te_agents sourcetype="silk:router:iface" iface IN ("Fa0/0/1","Lo0") | stats latest(alias) as Alias latest(admin_status) as Admin latest(oper_status) as Oper latest(speed_mbps) as nom latest(in_bps) as ib latest(out_bps) as ob latest(in_errors_ps) as ie latest(out_errors_ps) as oe latest(in_discards_ps) as di latest(out_discards_ps) as do_ by iface | eval "Nominal (Mbps)"=nom, "In (Mbps)"=round(ib/1000000,2), "Out (Mbps)"=round(ob/1000000,2), "Err/s"=round(ie+oe,2), "Descartes/s"=round(di+do_,2), Rol=case(iface="Fa0/0/1","LAN - Go2 (Jetson .18)", iface="Lo0","Management - loopback en tunel", true(),"-"), orden=case(iface="Fa0/0/1",1, iface="Lo0",2, true(),9) | sort orden | rename iface as Interfaz | table Interfaz Rol Alias Admin Oper "Nominal (Mbps)" "In (Mbps)" "Out (Mbps)" "Err/s" "Descartes/s"</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
        <format type="color" field="Oper"><colorPalette type="map">{"up":#53A051,"down":#DC4E41}</colorPalette></format>
        <format type="color" field="Admin"><colorPalette type="map">{"up":#53A051,"down":#707070}</colorPalette></format>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>CPU y memoria — IR1101</title>
      <chart>
        <search><query>index=te_agents (sourcetype="silk:router:cpu" OR (sourcetype="silk:router:mem" pool="Processor")) | timechart span=5m avg(cpu_1min_pct) as "CPU 1min (%)" avg(cpu_5min_pct) as "CPU 5min (%)" avg(used_pct) as "Memoria Processor (%)"</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">%</option>
        <option name="charting.axisY.maximumNumber">100</option>
        <option name="charting.axisY.minimumNumber">0</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <title>Temperatura y señal LTE</title>
      <chart>
        <search><query>index=te_agents (sourcetype="silk:router:env" OR sourcetype="silk:router:cellular") | timechart span=5m avg(temp_c) as "Temp TS1 (C)" avg(rssi_dbm) as "RSSI LTE (dBm)"</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="charting.chart">line</option>
        <option name="charting.axisY2.enabled">1</option>
        <option name="charting.chart.overlayFields">RSSI LTE (dBm)</option>
        <option name="charting.axisTitleY.text">°C</option>
        <option name="charting.axisTitleY2.text">dBm</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Tráfico por interfaz (Mbps)</title>
      <chart>
        <search><query>index=te_agents sourcetype="silk:router:iface" iface IN ("Gi0/0/0","Vl40","Ce0/1/0","Fa0/0/1") | eval mbps=(in_bps+out_bps)/1000000 | timechart span=5m avg(mbps) by iface</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">Mbps</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <title>IP SLA — RTT (ms)</title>
      <chart>
        <search><query>index=te_agents sourcetype="silk:router:ipsla" | eval sonda="SLA ".sla_id | timechart span=5m avg(rtt_ms) by sonda</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">ms</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>IP SLA — estado y disponibilidad</title>
      <table>
        <search><query>index=te_agents sourcetype="silk:router:ipsla" | stats latest(rtt_ms) as rtt latest(sense) as Estado count(eval(sense="ok")) as ok count as total by sla_id | eval "RTT (ms)"=rtt, "Disponibilidad (%)"=round(ok*100/total,1), n=tonumber(sla_id) | rename sla_id as SLA | sort n | table SLA Estado "RTT (ms)" "Disponibilidad (%)"</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
        <format type="color" field="Estado">
          <colorPalette type="map">{"ok":#53A051,"timeout":#DC4E41}</colorPalette>
        </format>
      </table>
    </panel>
    <panel>
      <title>Pools de memoria</title>
      <table>
        <search><query>index=te_agents sourcetype="silk:router:mem" | stats latest(used_mb) as "Usado (MB)" latest(free_mb) as "Libre (MB)" latest(total_mb) as "Total (MB)" latest(used_pct) as "Uso (%)" by pool | rename pool as Pool | sort - "Total (MB)"</query><earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest><refresh>60s</refresh><refreshType>delay</refreshType></search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </table>
    </panel>
  </row>
  <!-- ==== FIN SECCION IR1101 ==== -->
</form>