# meraki-hq -- every variable the service reads. Copy to .env and fill in; .env is gitignored.

# --- Meraki Dashboard API -------------------------------------------------------------
# READ-ONLY key: My Profile -> API access -> Generate new API key. Shown ONCE at creation.
# Keep it out of this file in production: write it to the key file below at mode 600, the
# same convention as ~/.te_bearer_token and the robot's ~/.splunk_hec_token.
# MERAKI_API_KEY=
MERAKI_API_KEY_FILE=~/.meraki_api_key
MERAKI_API_BASE=https://api.meraki.com/api/v1

# Organisation. Name OR id; the id skips a lookup and is stable across renames.
# If the key sees exactly one org, both can stay empty. If it sees several and neither is
# set, the poller EXITS rather than guessing -- indexing the wrong customer's network into
# a shared licence is not a recoverable mistake. This key sees FOUR organisations, two of
# which are other customers, so the id is not optional here.
# 610420 is 'Silk-Technologies' -- with a hyphen. Confirmed with --probe orgs on 2026-09-22.
MERAKI_ORG_ID=610420
# MERAKI_ORG=Silk-Technologies

# Comma-separated network NAMES, exactly as the Dashboard spells them. The value must match
# what the dashboard's "Red" dropdown offers, because every panel filters networkName.
# QUOTE IT: the names contain spaces, and an unquoted value breaks `. ./.env`.
# EMPTY MEANS EVERY NETWORK IN THE ORG.
# The org has four: 'Silk Lab' (9 devices, the live one), 'Itinerante' (one dormant MX68),
# 'Demo Meraki Cisco' and 'ROBOT' (both empty). There is NO network called 'Silk HQ'.
MERAKI_NETWORKS="Silk Lab,Itinerante"

# --- Cadence --------------------------------------------------------------------------
# Why these numbers, so the next person does not "optimise" them:
#  * 300 s for device/uplink/wireless: the loss-and-latency series Meraki keeps is itself
#    at 60 s granularity, and the failover panel buckets at 15 min. Faster buys nothing.
#  * 900 s for clients: the clients endpoint is the expensive one (pages of up to 1000)
#    and the panels bucket at 30 min.
#  * 3600 s for application traffic: Meraki aggregates it hourly upstream. Polling it
#    faster returns the same numbers and just spends licence.
MERAKI_INTERVAL_DEVICE_S=300
MERAKI_INTERVAL_UPLINK_S=300
MERAKI_INTERVAL_WIRELESS_S=300
MERAKI_INTERVAL_CLIENT_S=900
MERAKI_INTERVAL_APPTRAFFIC_S=3600

# --- Limits ---------------------------------------------------------------------------
# Meraki's documented ceiling is 5 req/s per organisation. We pace below it on purpose: a
# 429 storm degrades everything else sharing the org key, not just this poller.
MERAKI_MAX_RPS=4
MERAKI_MAX_RETRIES=4
MERAKI_MAX_PAGES=20
MERAKI_CLIENT_PER_PAGE=1000
MERAKI_HTTP_TIMEOUT=30
# channelUtilization/byDevice needs an explicit interval and a timespan at least as large;
# omitted, the API defaults interval to 3600 and rejects anything shorter with a 400.
MERAKI_WIRELESS_INTERVAL_S=300
MERAKI_STATE_FILE=/var/tmp/meraki-poller-state.json

# --- Splunk destination ---------------------------------------------------------------
MERAKI_INDEX=meraki
MERAKI_SOURCE=meraki:api

# --- Passed through to hec_shipper ------------------------------------------------------
# /services/collector/event, NOT the bare /services/collector that te-poller uses: this
# poller emits EVENTS, not metrics. The bare endpoint 400s every batch.
HEC_URL=https://localhost:8088/services/collector/event
HEC_INDEX=meraki
# The token of the MERAKI-HQ HEC input: Settings -> Data inputs -> HTTP Event Collector.
# Do NOT put it here. Write it to the file below at mode 600:
#   printf '%s' 'THE-TOKEN' > ~/.splunk_hec_meraki_token && chmod 600 ~/.splunk_hec_meraki_token
TOKEN_FILE=~/.splunk_hec_meraki_token
# 100 MB/day against a measured ~8 MB/day: a runaway guard, not a budget. It bounds ONLY
# the API families -- syslog and webhooks bypass the shipper entirely.
DAILY_BYTE_CAP=104857600
SPOOL_DIR=/var/tmp/meraki-poller-spool
# Splunk's certificate here is self-signed, and the HEC leg is localhost when this runs on
# the Splunk box -- which is why that is the recommended home. The Meraki leg is a
# different matter: api.meraki.com is publicly trusted and IS verified, unconditionally.
VERIFY_TLS=0
