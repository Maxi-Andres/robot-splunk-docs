# te-poller — every variable the service reads. Copy to .env and fill in; .env is gitignored.

# --- ThousandEyes -------------------------------------------------------------------
# Bearer token: Account Settings -> Users and Roles -> Profile -> User API Tokens.
# Shown ONCE at creation. Keep it out of this file in production: write it to the token
# file below with mode 600, the same convention as the robot's ~/.splunk_hec_token.
# TE_BEARER_TOKEN=
TE_TOKEN_FILE=~/.te_bearer_token
TE_API_BASE=https://api.thousandeyes.com/v7
# Account group id. Only needed if the token can see more than one; ours is SILK TECH SRL - 178.
TE_ACCOUNT_GROUP_ID=

# --- Cadence ------------------------------------------------------------------------
# 120 s against a 10 m window, matched to how often the tests themselves run. The overlap
# means a late round is never missed; the roundId watermark stops it being billed twice.
# Polling faster than the tests produce rounds buys nothing: the watermark drops it all.
TE_POLL_INTERVAL_S=120
TE_WINDOW=10m
TE_STATE_FILE=/var/tmp/te-poller-state.json

# --- Splunk destination ---------------------------------------------------------------
# Metrics MUST land in a metrics-type index, created with: splunk add index X -datatype metric
TE_METRIC_INDEX=thousandeyes
TE_SOURCETYPE=thousandeyes:otel
TE_SOURCE=thousandeyes:api

# --- Passed through to hec_shipper -----------------------------------------------------
# /services/collector, NOT /services/collector/event: this is the metrics endpoint.
HEC_URL=https://localhost:8088/services/collector
# The shipper's own health events are EVENTS. Never point this at the metrics index.
HEC_INDEX=thousandeyes_alerts
# 20 MB/day. The licence is 500 MB shared; Cisco telemetry already takes ~138 MB and the
# robot agent is capped at 150 MB. See ../LICENCIA-Y-THOUSANDEYES.md §2.1.g.
DAILY_BYTE_CAP=20971520
SPOOL_DIR=/var/tmp/te-poller-spool
# Splunk's certificate here is self-signed, so the shipper does not verify it. The link is
# localhost when the poller runs on the Splunk box, which is why that is the recommendation.
VERIFY_TLS=0
