# ThousandEyes -> Splunk bridge. Runs on the SPLUNK SERVER, not on the robot.
#   sudo cp systemd/splunk-te-poller.service /etc/systemd/system/
#   sudo systemctl enable --now splunk-te-poller
#
# TEMPORARY BY DESIGN. Delete this unit when the streaming integration is live; the
# migration plan is ../LICENCIA-Y-THOUSANDEYES.md §5.
[Unit]
Description=ThousandEyes API -> Splunk HEC (bridge until the official stream exists)
After=network-online.target
Wants=network-online.target
# In [Unit], not [Service]: systemd 245 silently ignores them under [Service], which
# disables the crash-loop guard without a word. Same trap as robot-telemetry-agent.
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
User=silkadmin
WorkingDirectory=/home/silkadmin/robot-splunk-docs/te-poller
EnvironmentFile=/home/silkadmin/robot-splunk-docs/te-poller/.env
ExecStart=/home/silkadmin/robot-splunk-docs/te-poller/run.sh
Restart=always
RestartSec=30
# This shares a box with splunkd, which is the thing that must not be starved.
MemoryMax=128M
CPUQuota=10%
Nice=10
[Install]
WantedBy=multi-user.target
